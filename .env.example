# ===== 必須 =====
# Gemini API キー (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Discord Webhook URL (サーバー設定 > 連携サービス > ウェブフック)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# ===== Claude Agent SDK =====
# Pro / Max のサブスク枠で使うトークン (1年有効)。
# 手元で `claude setup-token` を実行し、表示された値を書く。
# 未設定の場合は、このPCでログイン済みの Claude Code CLI の認証情報が使われる。
CLAUDE_CODE_OAUTH_TOKEN=
# 使用モデル (空なら Claude Code の既定モデル)
CLAUDE_MODEL=
# 調査の最大ターン数 / 予算上限(USD, 空なら無制限) / タイムアウト(秒)
CLAUDE_MAX_TURNS=80
CLAUDE_MAX_BUDGET_USD=
CLAUDE_TIMEOUT_SEC=2400

# ===== 任意 =====
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SEC=120

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 日本語フォント (空なら OS 標準フォントを自動検出)
PDF_FONT_PATH=
PDF_BOLD_FONT_PATH=

# 出力先 (空なら ./output)
OUTPUT_DIR=
